---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 p-5 rounded-xl border border-slate-700 bg-slate-800/60 shadow-lg" data-testid="game-filters">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="flex-1">
          <h2 class="text-xl font-medium text-slate-100 mb-3">Filter games</h2>
          <fieldset data-testid="category-filter-group">
            <legend class="sr-only">Filter by category</legend>
            <div class="flex flex-wrap gap-2">
              {categories.map((category) => (
                <label
                  class="inline-flex items-center gap-2 rounded-full border border-slate-600 bg-slate-900/70 px-3 py-2 text-sm text-slate-200 transition-colors duration-200 hover:border-blue-500 hover:text-blue-200 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none"
                  data-testid="category-filter-label"
                >
                  <input
                    type="checkbox"
                    value={category.id}
                    data-testid="category-filter"
                    data-category-id={category.id}
                    class="h-4 w-4 rounded border-slate-500 bg-slate-800 text-blue-500 focus:ring-2 focus:ring-blue-500"
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>

        <label class="flex w-full max-w-xs flex-col gap-2 text-sm font-medium text-slate-200">
          <span>Publisher</span>
          <select
            data-testid="publisher-filter"
            aria-label="Filter games by publisher"
            class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 shadow-sm transition-colors duration-200 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={publisher.id}>{publisher.name}</option>
            ))}
          </select>
        </label>
      </div>

      <div class="mt-4 flex items-center justify-between gap-3">
        <p class="text-sm text-slate-300" data-testid="results-count">Showing {games.length} games</p>
        <button
          type="button"
          data-testid="clear-filters-button"
          class="rounded-md border border-slate-600 bg-slate-900 px-3 py-2 text-sm font-medium text-slate-200 transition-colors duration-200 hover:border-blue-500 hover:text-blue-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          Clear filters
        </button>
      </div>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>

    <div class="mt-6 hidden" data-testid="filtered-empty-state">
      <EmptyState text="No games match the selected filters." />
    </div>
  </div>
</Layout>

<script>
  const categoryFilters = Array.from(document.querySelectorAll<HTMLInputElement>('[data-testid="category-filter"]'));
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const clearFiltersButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters-button"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const resultsCount = document.querySelector<HTMLElement>('[data-testid="results-count"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  const applyFilters = () => {
    const selectedCategories = categoryFilters
      .filter((checkbox) => checkbox.checked)
      .map((checkbox) => Number(checkbox.value));
    const selectedPublisher = publisherFilter && publisherFilter.value ? Number(publisherFilter.value) : null;

    let visibleCount = 0;

    for (const card of gameCards) {
      const cardCategoryId = card.dataset.gameCategory ? Number(card.dataset.gameCategory) : null;
      const cardPublisherId = card.dataset.gamePublisher ? Number(card.dataset.gamePublisher) : null;
      const matchesCategory =
        selectedCategories.length === 0 || (cardCategoryId !== null && selectedCategories.includes(cardCategoryId));
      const matchesPublisher = selectedPublisher === null || cardPublisherId === selectedPublisher;
      const isVisible = matchesCategory && matchesPublisher;
      card.hidden = !isVisible;

      if (isVisible) {
        visibleCount += 1;
      }
    }

    if (resultsCount) {
      resultsCount.textContent = `Showing ${visibleCount} game${visibleCount === 1 ? '' : 's'}`;
    }

    if (emptyState) {
      emptyState.hidden = visibleCount > 0;
    }
  };

  categoryFilters.forEach((checkbox) => {
    checkbox.addEventListener('change', applyFilters);
  });

  if (publisherFilter) {
    publisherFilter.addEventListener('change', applyFilters);
  }

  if (clearFiltersButton) {
    clearFiltersButton.addEventListener('click', () => {
      categoryFilters.forEach((checkbox) => {
        checkbox.checked = false;
      });
      if (publisherFilter) {
        publisherFilter.value = '';
      }
      applyFilters();
    });
  }

  applyFilters();
</script>
